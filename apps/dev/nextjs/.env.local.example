# Rename file to .env.local (or .env) and populate values
# to be able to run the dev app

# You can use `openssl rand -hex 32` or 
# https://generate-secret.vercel.app/32 to generate a secret.
# Note: Changing a secret may invalidate existing sessions
# and/or verification tokens.
AUTH_SECRET=

AUTH_ASGARDEO_CLIENT_ID=
AUTH_ASGARDEO_CLIENT_SECRET=
AUTH_ASGARDEO_ISSUER=

AUTH_AUTH0_ID=
AUTH_AUTH0_SECRET=
AUTH_AUTH0_ISSUER=

AUTH_ORY_HYDRA_CLIENT_ID=
AUTH_ORY_HYDRA_CLIENT_SECRET=
AUTH_ORY_HYDRA_ISSUER=

# Beyond Identity Provider
AUTH_BEYOND_IDENTITY_CLIENT_ID=
AUTH_BEYOND_IDENTITY_CLIENT_SECRET=
AUTH_BEYOND_IDENTITY_ISSUER=

AUTH_DESCOPE_ID=
AUTH_DESCOPE_SECRET=
AUTH_DESCOPE_ISSUER=

AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

AUTH_NOTION_ID=
AUTH_NOTION_SECRET=
AUTH_NOTION_REDIRECT_URI=

AUTH_IDS4_ID=
AUTH_IDS4_SECRET=
AUTH_IDS4_ISSUER=

AUTH_KEYCLOAK_ID=
AUTH_KEYCLOAK_SECRET=
# Required even for credentials-only local Auth.js initialization.
# IAM.md documents an inert local issuer; real OAuth needs actual provider config.
AUTH_KEYCLOAK_ISSUER=

AUTH_LINE_ID=
AUTH_LINE_SECRET=

AUTH_TRAKT_ID=
AUTH_TRAKT_SECRET=

AUTH_TWITCH_ID=
AUTH_TWITCH_SECRET=

AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

AUTH_WIKIMEDIA_ID=
AUTH_WIKIMEDIA_SECRET=

AUTH_FRONTEGG_ID=
AUTH_FRONTEGG_SECRET=
AUTH_FRONTEGG_ISSUER=

# Yandex OAuth. new app -> https://oauth.yandex.com/client/new/id
AUTH_YANDEX_ID=
AUTH_YANDEX_SECRET=

# ClickUp OAuth. https://clickup.com/api/
AUTH_CLICK_UP_ID=
AUTH_CLICK_UP_SECRET=

# Optional Auth.js email provider; configure securely when needed.
EMAIL_SERVER=
EMAIL_FROM=

# PostgreSQL only; IAM.md explains dedicated local environment sourcing.
# Template: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=

# IAM PostgreSQL/Redis: use dedicated databases; never reset an existing database.
# DATABASE_URL above must point to the intended PostgreSQL database.
REDIS_URL=
IAM_TEST_DATABASE_URL=
# Generate independent keys locally with openssl; see IAM.md rotation effects.
# Template: redis://:<password>@<host>:<port>
# Replace AUTH_SECRET above with an independent secret of at least 32 bytes.
APP_JWT_SECRET=
APP_JWT_TTL=900
# Independent canonical base64 encoding of exactly 32 bytes.
MFA_ENCRYPTION_KEY=
# Exact deployment origin required for sensitive browser mutation checks.
IAM_ORIGIN=
# Required only for invitation sending; HTTPS in production.
RESEND_API_KEY=
INVITATION_FROM=
INVITATION_ORIGIN=
# Optional explicit local demo; production rejects this setting.
IAM_DEV_CREDENTIALS=
# Operator seed only: existing active tenant; absent means tenant roles are skipped.
IAM_SEED_ORG_ID=
# Optional deliberate administrator bootstrap: existing active member of seed tenant.
# Never create a password, user, membership or application access through seed.
IAM_BOOTSTRAP_USER_ID=
