{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "allowJs": false,
    "incremental": false,
    "moduleResolution": "bundler",
    "types": ["node", "vitest/globals"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "auth.ts",
    "auth.config.ts",
    "src/lib/**/*.ts",
    "vitest.config.ts",
    "prisma/seed/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
